# ---- window rules (ported from lua/window_rules.lua) -------------------------
# Wayland apps are matched by app_id, apps running through XWayland (Steam, older programs) by class - so most rules
# come in pairs. Apps that draw their own title bar (Firefox, Chrome, GNOME apps...) would get no border, so
# every window gets one; AutoTiling.py puts it back when an app drops it later. To hide a window's border on
# purpose, use "border pixel 0" like the mpv rule below - "border none" would be undone.
for_window [all] border pixel 3
for_window [window_role="(pop-up|dialog|task_dialog|About)"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="splash"] floating enable
for_window [app_id="(?i)^(zoom|onedriver|onedriver-launcher)$"] floating enable
for_window [class="(?i)^(zoom|onedriver|onedriver-launcher)$"] floating enable
for_window [app_id="^(mpv|com.github.rafostar.Clapper)$"] floating enable
for_window [class="^(mpv|com.github.rafostar.Clapper)$"] floating enable
for_window [app_id="(?i)^(qalculate-gtk|org.gnome.Calculator)$"] floating enable, resize set 600 500, move position center
for_window [title="^(Authentication [Rr]equired)$"] floating enable, move position center
for_window [app_id="(?i)^(xfce-polkit|mate-polkit|polkit-mate-authentication-agent-1|polkit-gnome-authentication-agent-1|lxpolkit|org.kde.polkit-kde-authentication-agent-1|lxqt-policykit-agent)$"] floating enable, move position center
for_window [class="(?i)^(xfce-polkit|mate-polkit|polkit-mate-authentication-agent-1|polkit-gnome-authentication-agent-1|lxpolkit)$"] floating enable, move position center
for_window [title="^(Add Folder to Workspace|Save As|Open Files?)$"] floating enable, resize set 70 ppt 60 ppt, move position center
for_window [app_id="^yad$"] floating enable, move position center
# the screenshot editor (SUPER+Shift+S): floating at the size it picks (the snip at 1:1, or shrunk to fit), centered -
# tiled, it would be stretched to whatever shape the tile has
for_window [app_id="(?i)^swappy$"] floating enable, move position center
for_window [app_id="(?i)^(pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol)$"] floating enable, resize set 900 600, move position center
for_window [app_id="(?i)^nm-connection-editor$"] floating enable, move position center
for_window [app_id="(?i)^nm-applet$"] floating enable, move position center
for_window [app_id="(?i)^(nwg-look|nwg-displays|\.?blueman-manager(-wrapped)?)$"] floating enable, move position center
for_window [app_id="^swaydots-settings$"] floating enable, move position center
for_window [app_id="(?i)^(nvidia-settings|org.kde.kwalletmanager|bitwarden|com.github.wwmm.easyeffects|io.github.amit9838.mousam|nz.co.mega.megasync|wihotspot|wihotspot-gui|ferdium)$"] floating enable, move position center
for_window [class="(?i)^(nvidia-settings|bitwarden|nz.co.mega.megasync|ferdium)$"] floating enable, move position center
for_window [app_id="(?i)^(whatsapp-for-linux|zapzap|com.rtosta.zapzap)$"] move position center
for_window [title="^(KooL Quick Cheat Sheet|Keybindings|ROG Control)$"] floating enable, move position center
for_window [class="(?i)^steam$" title="^(?!Steam$).+"] floating enable
for_window [app_id="(?i)^steam$" title="^(?!Steam$).+"] floating enable
for_window [title="^[Pp]icture-in-[Pp]icture$"] floating enable, sticky enable, resize set 480 270
for_window [app_id="^com\.swaydots\.dropterm$"] floating enable, resize set 1200 600, move position center, move scratchpad, scratchpad show
for_window [app_id="^kitty-dropterm$"] floating enable, resize set 1200 600, move position center, move scratchpad, scratchpad show
for_window [app_id="^(gamescope|steam_app_.*)$"] fullscreen enable
for_window [class="^(gamescope|steam_app_.*)$"] fullscreen enable
for_window [app_id="^(mpv|vlc|org.videolan.VLC)$"] border pixel 0
for_window [class="^(mpv|vlc)$"] border pixel 0
# a video playing in fullscreen keeps the screen awake (no lock, no screen power-off)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# ---- input and screens (written by the settings window: Settings > Mouse & touchpad, Displays) ----------
# keyboard layout, key repeat, Num Lock; touchpad tapping and natural scrolling (yours to edit)
include ~/.config/sway/input.conf
# the mouse / touchpad speed and acceleration you chose in Settings > Mouse & touchpad
include ~/.config/sway/mouse.conf
# resolution, refresh rate, scale, position and rotation of each screen
include ~/.config/sway/outputs.conf
# touchpad gestures: three fingers left / right for the next / previous workspace (Settings > Mouse & touchpad)
include ~/.config/sway/gestures.conf
# the wallpaper (Wallpaper.sh writes it, so it is still there after a reload)
include ~/.config/sway/wallpaper.conf
# the mouse cursor's theme and size (Settings > Mouse > Mouse cursor)
include ~/.config/sway/cursor.conf

# ---- autostart (ported from lua/startup.lua) --------------------------------------
# programs started by D-Bus or systemd (notifications, the screen-sharing portal, the config updater) need to know
# this session: Wayland display, sway's socket, the desktop name. No systemd: D-Bus only
exec sh -c 'v="WAYLAND_DISPLAY DISPLAY SWAYSOCK I3SOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland"; if command -v systemctl >/dev/null 2>&1; then dbus-update-activation-environment --systemd $v 2>/dev/null || systemctl --user import-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK; else dbus-update-activation-environment $v 2>/dev/null; fi'
exec $scripts/Polkit.sh
exec $scripts/Dunst.sh
# screen lock after 10 minutes, screens off after 12, lock before sleep (swayidle; "stay awake" stops it)
exec $scripts/Idle.sh
exec $scripts/ClipDaemon.sh
# NetworkManager's password helper (nm-applet), with its tray icon hidden: the Wi-Fi item in the bar opens
# Settings > Wi-Fi instead. The icon can be switched back on there. (exec_always: it only starts once.)
exec_always $scripts/NetApplet.sh
# the cursor and GTK theme you picked in Settings, for Wayland and XWayland apps (exec_always: starts once)
exec_always $scripts/XSettings.sh
# saved settings (written by the settings window): cursor, terminal colours... Then the wallpaper (the first time:
# the default one) and the wallpaper slideshow from Settings > Wallpaper, if it is on
exec sh -c '~/.config/sway/scripts/SettingsGUI.py --apply; ~/.config/sway/scripts/Wallpaper.sh --restore; ~/.config/sway/scripts/WallCycle.sh --start'
exec $scripts/Nightlight.sh init
# game mode never survives a logout (its gaps/effects changes are gone too)
exec rm -f ~/.cache/sway/gamemode
exec $scripts/first-run.sh
# after a system update you were not logged in for: check GitHub for a newer desktop config (a notification;
# installing it is up to you: swaydots-update)
exec $scripts/Update.sh --login
# the bar (Waybar), started again on every reload so it picks up new colours and screens
exec_always ~/.config/waybar/launch.sh
# SwayFX: rounded corners, blur, shadows (Settings > Appearance). Plain sway: nothing to do
exec_always $scripts/Effects.sh
# Hyprland-style spiral tiling (new windows split the focused one along its longer side), the focus ring and the
# window transparency. Only one copy runs. Mode: SUPER+ALT+T or Settings > Appearance > Window tiling.
exec_always $scripts/AutoTiling.py

