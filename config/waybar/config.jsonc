    "format": "{}",
    "escape": false,
    "tooltip": false,
    "on-scroll-up": "swaymsg -q workspace next_on_output",
    "on-scroll-down": "swaymsg -q workspace prev_on_output",
    "on-click": "swaymsg -q workspace number 10"
  },
  "custom/wsx": {
    "exec": "cat \"$XDG_RUNTIME_DIR/swaydots-bar/${WAYBAR_OUTPUT_NAME:-_any}/x\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "escape": false,
    "tooltip": false,
    "on-scroll-up": "swaymsg -q workspace next_on_output",
    "on-scroll-down": "swaymsg -q workspace prev_on_output"
  },
  "custom/wsmode": {
    "exec": "cat \"$XDG_RUNTIME_DIR/swaydots-bar/${WAYBAR_OUTPUT_NAME:-_any}/mode\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "escape": false,
    "tooltip": false,
    "on-scroll-up": "swaymsg -q workspace next_on_output",
    "on-scroll-down": "swaymsg -q workspace prev_on_output"
  },
  "tray": {
    "icon-size": 23,
    "spacing": 6
  }
}
